{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Organizer",
  "version": "2.0.0",
  "identifier": "dev.musicorganizer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Music Organizer",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/artwork/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Organize your music library",
    "longDescription": "Import playlists from Spotify, YouTube and SoundCloud, match them to YouTube and download tagged audio.",
    "category": "Music",
    "copyright": "Copyright (c) 2026 Enrico Papsch Di Giacomo",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsecret-1-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libsecret"
        ]
      }
    }
  }
}
